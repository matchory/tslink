---
import PageFooter from "@/components/PageFooter.astro";
import PageHeader from "@/components/PageHeader.astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MermaidViewport from "../components/MermaidViewport.astro";
import {repoUrl} from "../lib/navigation";
import {getLastModified} from "../lib/git";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description: string;
    slug: string;
    headings: Heading[];
    markdownUrl?: string;
    category?: string;
    tags?: string[];

    /**
     * The page's source file, relative to the repository root. A page without
     * one gets neither an edit link nor a modified date.
     */
    sourcePath?: string;
}

const {
    title,
    description,
    slug,
    headings,
    markdownUrl,
    category,
    tags,
    sourcePath,
} = Astro.props;
// `undefined` rather than `null`: every component below models an absent date
// or edit link as an omitted prop.
const lastModified = (sourcePath ? await getLastModified(sourcePath) : null) ?? undefined;
const editUrl = sourcePath ? `${repoUrl}/edit/main/${sourcePath}` : undefined;
---

<BaseLayout
    title={title}
    description={description}
    slug={slug}
    lastModified={lastModified}
    alternate={markdownUrl ? {href: markdownUrl} : undefined}
>
    <main
        id="main-content"
        class="flex-1 min-w-0 py-10 px-8 md:px-12 lg:px-16"
        transition:animate="fade"
    >
        <article class="mx-auto" data-pagefind-body>
            <PageHeader
                title={title}
                editUrl={editUrl}
                markdownUrl={markdownUrl}
                tags={tags}
                description={description}
                category={category}
            />

            <div class="prose">
                <slot />
            </div>

            <PageFooter slug={slug} lastModified={lastModified} editUrl={editUrl} />
        </article>
    </main>

    <TableOfContents headings={headings} />

    <MermaidViewport />

    <div id="copy-status" class="sr-only" aria-live="polite" role="status"></div>

    <script is:inline>
        const copyClass =
            "cursor-pointer px-1 py-0.25 text-2xs font-medium uppercase tracking-wide text-muted-foreground transition-colors hover:text-foreground select-none";

        function copyWithFeedback(button, text) {
            navigator.clipboard.writeText(text).then(() => {
                button.textContent = "Copied!";

                const status = document.getElementById("copy-status");

                if (status) {
                    status.textContent = "Copied to clipboard";
                }

                setTimeout(() => {
                    button.textContent = "Copy";

                    if (status) {
                        status.textContent = "";
                    }
                }, 2000);
            });
        }

        document.addEventListener("astro:page-load", () => {
            document
                .querySelectorAll(".prose table:not([data-initialized])")
                .forEach((table) => {
                    table.setAttribute("data-initialized", "");

                    const wrapper = document.createElement("div");
                    wrapper.className = "my-6 overflow-x-auto -mx-1 px-1";

                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(table);
                });

            document
                .querySelectorAll(".prose pre:not([data-initialized])")
                .forEach((pre) => {
                    pre.setAttribute("data-initialized", "");

                    const wrapper = document.createElement("div");
                    wrapper.className = "relative";

                    pre.parentNode.insertBefore(wrapper, pre);
                    wrapper.appendChild(pre);

                    const button = document.createElement("button");
                    button.className = `absolute right-1.5 top-1.5 z-1 ${copyClass}`;
                    button.textContent = "Copy";

                    button.addEventListener("click", () => {
                        const code = pre.querySelector("code");

                        copyWithFeedback(
                            button,
                            code ? code.textContent : pre.textContent,
                        );
                    });
                    wrapper.appendChild(button);
                });
        });
    </script>
</BaseLayout>
