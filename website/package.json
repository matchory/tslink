{
  "name": "tslink-website",
  "version": "1.0.0",
  "private": true,
  "description": "The tslink documentation website, at https://matchory.github.io/tslink/.",
  "repository": "https://github.com/matchory/tslink",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "astro dev stop; pkill -f \"$PWD/node_modules/astro/bin/astro.mjs (dev|preview)\" || true; rm -rf .astro node_modules/.vite && npm run dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "check-links": "node scripts/check-links.ts",
    "test:links": "node --test scripts/check-links.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.2",
    "fontkit": "^2.0.4",
    "pagefind": "^1.5.2",
    "pele": "^1.9.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/unist": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "packageManager": "pnpm@12.4.2"
}
