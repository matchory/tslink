{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Astro's base config enables `allowJs` and includes `**/*`, excluding only
  // `dist`. `public/` holds no source, so it stays out of the program. Listing
  // `dist` again is not redundant: `exclude` replaces the inherited value
  // rather than extending it.
  "exclude": ["dist", "public"]
}
