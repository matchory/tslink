---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getDocPaths } from "../lib/docs";
import { withBase } from "../lib/paths";

export async function getStaticPaths() {
  const docs = await getDocPaths();

  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { entry: doc },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// The collection is loaded from `../docs`, so the loader reports paths relative
// to this project; the edit link and the modified date both want them relative
// to the repository root.
const sourcePath = entry.filePath?.replace(/^\.\.\//, "");
---
<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  headings={headings}
  markdownUrl={withBase(`/${entry.id}.md`)}
  sourcePath={sourcePath}
  category={entry.data.category}
  tags={entry.data.tags}
>
  <Content />
</DocsLayout>
