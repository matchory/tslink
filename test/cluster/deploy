#!/bin/bash
# deploy <stack> [secret] -- docker stack deploy on $MGR (default mgr), with
# $TSLINK_TEST_DIR/<secret>.secret as TSLINK_OAUTH_SECRET and the tag and Service prefixes from
# config.sh; the secret travels on stdin, never on a command line
set -euo pipefail
B=$(dirname "$0")
# shellcheck source=config.sh
. "$B/config.sh"
st=$1
sec=${2:-$1}
scp -q -F "$TSLINK_TEST_SSH_CONFIG" "$B/stacks/$st.yml" "${MGR:-mgr}:/root/$st.yml"
{
	printf 'TSLINK_TEST_TAG=%q\nTSLINK_TEST_SVC=%q\n' "$TSLINK_TEST_TAG" "$TSLINK_TEST_SVC"
	printf 'TSLINK_OAUTH_SECRET='
	cat "$TSLINK_TEST_DIR/$sec.secret"
} | "$B/s" "${MGR:-mgr}" "set -a; . /dev/stdin; set +a; docker stack deploy -d -c /root/$st.yml $st"
