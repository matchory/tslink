#!/bin/bash
# probes start [ip [args]]|stop|report -- VIP probes in the caller tasks on all nodes. ip defaults
# to the VIP of $TSLINK_TEST_SVC-callee. $PROBE selects the probe script (default probe.sh); args
# follow the log file on its command line.
B=$(dirname "$0")
# shellcheck source=config.sh
. "$B/config.sh"
target=$2
[ "$1" = start ] && [ -z "$target" ] &&
	target=$("$B/tsapi" GET "/tailnet/$TSLINK_TEST_TAILNET/services/$TSLINK_TEST_SVC-callee" | jq -r '.addrs[0]')
args=${*:3}
probe=${PROBE:-probe.sh}
# shellcheck disable=SC2016 # awk program, expanded in the container
report='awk "{n++; if(\$3!=\"200\"){f++; if(!fs)fs=\$2; fe=\$2}; b[\$4]++} END{printf \"requests=%d failed=%d fail_window=%.1fs\n\", n, f, fe-fs; for(k in b) printf \"  %s %d\n\", k, b[k]}" /tmp/probe.log'
for n in $("$B/nodes"); do
	case $1 in
	start) "$B/s" "$n" "c=\$(docker ps -q -f label=com.docker.swarm.service.name=caller_client|head -1); cat > /tmp/probe.sh; docker cp /tmp/probe.sh \$c:/probe.sh; docker exec -d \$c sh /probe.sh $target /tmp/probe.log $args" <"$B/$probe" ;;
	stop) "$B/cx" "$n" caller_client 'pkill -f probe.sh' ;;
	report)
		echo "== $n"
		"$B/cx" "$n" caller_client "$report"
		;;
	esac
done
